# RESILIX Environment Configuration Example
# Copy this file to .env to customize local runtime settings. Never commit real production secrets.

RESILIX_APP_NAME=RESILIX
RESILIX_ENV=development
RESILIX_HOST=127.0.0.1
RESILIX_PORT=8000
RESILIX_DB_PATH=./resilix.db
RESILIX_SECRET_KEY=replace-with-32-byte-hex-secret-in-production
RESILIX_SESSION_TTL_MINUTES=480
RESILIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
RESILIX_MAX_REQUEST_BYTES=262144
RESILIX_LOGIN_MAX_ATTEMPTS=5
RESILIX_LOGIN_WINDOW_SEC=60
